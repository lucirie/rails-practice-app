<h1>This is /products/<%= @id %></h1>

<% cache @product do %>
<div id="product">
    <%= image_tag @product.featured_image if @product.featured_image.attached? %>
    <%= @product.name %>
    <%= @product.description %>
    <%= @product.created_at %>
</div>
<% end %>

<%= link_to "Go Back", products_path %>

<% if authenticated? %>
    <%= link_to "Edit this product", edit_product_path(@product) %>
    <%= button_to "Delete", @product, method: :delete, data: { turbo_confirm: "Are you super duper sure?" } %>
<% end %>